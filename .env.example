DATABASE_URL="postgresql://postgres:password@localhost:5433/ai_employee_db"
API_PORT=3001
GOOGLE_GEMINI_API_KEY="your_gemini_api_key_here"
AGENT_SERVICE_URL="http://localhost:8000"
REDIS_URL="redis://localhost:6380"
# Shared secret used between the Fastify API and the Python agent service.
# Must be the same value in both services. Change before deploying.
INTERNAL_SECRET="change-this-to-a-random-32-char-secret"
# Secret key for signing JWT session cookies
JWT_SECRET="change-this-to-a-random-32-char-secret"
# Optional: extra CORS origins beyond the defaults (comma-separated).
# Only needed for custom domains. Defaults already include onrender.com and localhost:3000.
# CORS_ORIGIN="https://yourdomain.com,https://app.yourdomain.com"